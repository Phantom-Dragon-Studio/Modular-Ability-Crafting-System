/* Main Container */
.hotbar-container {
    position: absolute;
    bottom: 20px;
    left: 50%;
    translate: -50% 0;
    width: 600px;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 10px;
    padding: 10px;
}

/* Title */
.hotbar-title {
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
    margin-bottom: 5px;
    -unity-font-style: bold;
}

/* Slots Container */
.slots-container {
    flex-direction: row;
    justify-content: space-around;
    margin-bottom: 10px;
}

/* Individual Spell Slot */
.spell-slot {
    width: 80px;
    height: 80px;
    background-color: rgba(50, 50, 50, 0.9);
    border-width: 2px;
    border-color: rgb(100, 100, 100);
    border-radius: 8px;
    position: relative;
    transition-duration: 0.2s;
}

.spell-slot:hover {
    border-color: rgb(255, 200, 100);
    scale: 1.05;
}

/* Spell Icon */
.spell-icon {
    width: 100%;
    height: 100%;
    background-size: contain;
    background-position: center;
}

.spell-icon:empty {
    background-color: rgba(0, 0, 0, 0.3);
}

/* Key Hint (number) */
.key-hint {
    position: absolute;
    top: 2px;
    right: 2px;
    font-size: 12px;
    color: rgb(200, 200, 200);
    background-color: rgba(0, 0, 0, 0.8);
    padding: 2px 5px;
    border-radius: 3px;
    -unity-font-style: bold;
}

/* Cooldown Text */
.cooldown-text {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    text-shadow: 2px 2px 2px rgba(0, 0, 0, 0.8);
}

/* Cooldown Progress Bar */
.cooldown-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
}

.cooldown-bar .unity-progress-bar__background {
    background-color: rgba(0, 0, 0, 0.5);
}

.cooldown-bar .unity-progress-bar__progress {
    background-color: rgb(255, 200, 100);
}

/* Mana Container */
.mana-container {
    flex-direction: row;
    align-items: center;
    padding: 5px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 5px;
}

.mana-label {
    font-size: 14px;
    color: rgb(100, 200, 255);
    margin-right: 10px;
    min-width: 50px;
    -unity-font-style: bold;
}

.mana-bar {
    flex-grow: 1;
    height: 20px;
    margin-right: 10px;
}

.mana-bar .unity-progress-bar__background {
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 10px;
}

.mana-bar .unity-progress-bar__progress {
    background-color: rgb(100, 150, 255);
    border-radius: 10px;
}

.mana-text {
    font-size: 12px;
    color: rgb(200, 220, 255);
    min-width: 80px;
}

/* State Classes */
.spell-slot--on-cooldown {
    opacity: 0.5;
}

.spell-slot--no-mana {
    border-color: rgb(200, 50, 50);
}

.spell-slot--ready {
    border-color: rgb(100, 255, 100);
}
